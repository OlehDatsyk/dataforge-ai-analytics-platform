# DataForge AI configuration. Copy to .env, or let setup.bat / setup.command create it for you.
# Every value here is a placeholder or a safe default. Never commit a real .env file.

# ---------- Application ----------
# development | test | production. Production requires SECRET_KEY and ENCRYPTION_KEY,
# forces secure cookies, adds HSTS, and stops showing password reset links on screen.
ENVIRONMENT=development

# Signs CSRF tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Encrypts stored connection credentials. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this later makes existing stored credentials unreadable.
ENCRYPTION_KEY=change-me

# ---------- Database and file storage ----------
# Leave empty to use a local SQLite file in the data directory.
# PostgreSQL example: postgresql://dataforge:your-password@localhost:5432/dataforge
DATABASE_URL=
# Where original files and processed Parquet versions are stored. Default: ./data
DATA_DIR=

# ---------- Sessions and browser access ----------
SESSION_TTL_HOURS=72
# Set to true whenever the app is served over HTTPS.
COOKIE_SECURE=false
# Front-end origins allowed to call the API, comma-separated. Same-origin requests are always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base URL used in password reset links.
PUBLIC_APP_URL=http://127.0.0.1:8000

# ---------- Resource limits ----------
MAX_UPLOAD_MB=100
MAX_ROWS=2000000
MAX_COLUMNS=500
MAX_PAGE_SIZE=500
QUERY_TIMEOUT_SECONDS=30
QUERY_MEMORY_LIMIT=1GB
INGEST_TIMEOUT_SECONDS=600

# ---------- Background processing ----------
# Files are processed by a worker pool inside the API process. No separate service is needed.
JOB_WORKERS=2

# ---------- Rate limits (requests per minute, per client address) ----------
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=30

# ---------- AI providers (all optional; without a key the app runs in demonstration mode) ----------
# auto selects the first provider with a key, in the order anthropic, openai, gemini.
# demo forces demonstration mode, even when keys are present.
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=60
# Whether up to 15 common labels per category column are sent to the provider, to help it build filters.
AI_SHARE_CATEGORY_VALUES=true
AI_MAX_CONTEXT_TURNS=6

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Required when OPENAI_API_KEY is set. It must support JSON-schema structured output.
OPENAI_MODEL=
GEMINI_API_KEY=
# Required when GEMINI_API_KEY is set.
GEMINI_MODEL=

# ---------- External data connections ----------
# Keep false in shared deployments. True permits connections to private and internal addresses.
ALLOW_PRIVATE_CONNECTIONS=false
CONNECTION_TIMEOUT_SECONDS=20
CONNECTION_MAX_ROWS=200000
CONNECTION_MAX_RESPONSE_MB=50

# ---------- E-mail for password resets (optional) ----------
# Without SMTP, development mode shows the reset link on screen; production cannot deliver it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Static hosting (optional) ----------
# Defaults to frontend/dist when it exists.
FRONTEND_DIST=
